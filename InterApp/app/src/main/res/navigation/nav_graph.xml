<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.inter.interapp.ui.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login"
        xmlns:tools="http://schemas.android.com/tools">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.inter.interapp.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home"
        xmlns:tools="http://schemas.android.com/tools">
        <action
            android:id="@+id/action_home_to_tablas"
            app:destination="@id/tablasFragment"/>
        <action
            android:id="@+id/action_home_to_localidades"
            app:destination="@id/localidadesFragment"/>
    </fragment>

    <fragment
        android:id="@+id/tablasFragment"
        android:name="com.inter.interapp.ui.tablas.TablasFragment"
        android:label="Tablas"
        tools:layout="@layout/fragment_tablas"
        xmlns:tools="http://schemas.android.com/tools"/>

    <fragment
        android:id="@+id/localidadesFragment"
        android:name="com.inter.interapp.ui.localidades.LocalidadesFragment"
        android:label="Localidades"
        tools:layout="@layout/fragment_localidades"
        xmlns:tools="http://schemas.android.com/tools"/>

</navigation>